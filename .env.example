# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key from https://aistudio.google.com (Get API key). The free tier is enough.
# Default for hosted sessions; reviewers may override it per session (see docs/API.md).
GOOGLE_API_KEY=

# Google Cloud project used to run BigQuery jobs (the free BigQuery sandbox is enough).
# Authenticate once with: gcloud auth application-default login
GCP_PROJECT_ID=

# Optional: override the default models (exact ids as listed in AI Studio).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Optional: salt for customer-id pseudonyms. Any random string; keep it secret in production.
ID_SALT=

# Optional: also send traces to Langfuse Cloud. Leave empty to keep traces local only;
# missing or wrong keys never stop the agent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# HTTP API only: JSON mapping of configured user ids to separate random bearer keys.
# Generate EACH key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example shape (replace the placeholder before running the API):
# ANALYST_API_KEYS='{"anna":"REPLACE_WITH_A_RANDOM_KEY_OF_AT_LEAST_32_CHARACTERS"}'
ANALYST_API_KEYS=
# API startup also requires a private ID_SALT above.
# On the VPS use a read-only mounted credentials file (see docs/DEPLOYMENT.md).

# Optional public-data demo: user selection instead of entering a private access key.
# Simulated identities, NOT production authentication. Anyone may choose CEO.
ANALYST_DEMO_ENABLED=false
ANALYST_DEMO_DAILY_TURNS=50
