# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key from https://aistudio.google.com (Get API key). The free tier is enough.
GOOGLE_API_KEY=

# Google Cloud project used to run BigQuery jobs (the free BigQuery sandbox is enough).
# Authenticate once with: gcloud auth application-default login
GCP_PROJECT_ID=

# Optional: override the default models (exact ids as listed in AI Studio).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Optional: salt for customer-id pseudonyms. Any random string; keep it secret in production.
ID_SALT=

# Optional: also send traces to Langfuse Cloud. Leave empty to keep traces local only;
# missing or wrong keys never stop the agent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
